# Copy to .env and fill in. Never commit .env.
PORT=4000
NODE_ENV=development

# Supabase project credentials (Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-publishable-key
SUPABASE_SERVICE_KEY=your-secret-service-role-key

# Comma-separated list of allowed frontend origins (CORS + password reset links)
FRONTEND_URL=http://localhost:5173

# Transactional email via Resend (invite notifications). Optional: if unset,
# the backend logs instead of sending and everything else keeps working.
# Sign up at https://resend.com, then put the key here.
RESEND_API_KEY=
# Verified sender, e.g. "VoteHub <hello@yourdomain.com>".
# Without a verified domain, Resend's onboarding address still delivers to you.
EMAIL_FROM=VoteHub <onboarding@resend.dev>
